{
  "name": "tw-glass",
  "version": "0.0.5",
  "description": "Tailwind CSS v4 plugin for glass refraction effects via SVG displacement maps",
  "keywords": [
    "tailwindcss",
    "tailwind",
    "glass",
    "glassmorphism",
    "refraction",
    "displacement",
    "backdrop-filter",
    "css"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "style": "./src/index.css",
      "default": "./src/index.css"
    },
    "./filter-builder": {
      "types": "./scripts/filter-builder.d.mts",
      "default": "./scripts/filter-builder.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./src/index.css",
  "files": [
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./src/index.css"
  ],
  "peerDependencies": {
    "tailwindcss": ">=4.0.0 <5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://www.assistant-ui.com/tw-glass",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/tw-glass"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs && oxfmt src/index.css",
    "generate:check": "node scripts/generate.mjs && oxfmt src/index.css && git diff --exit-code src/index.css",
    "test": "node --test \"test/*.test.mjs\""
  }
}
